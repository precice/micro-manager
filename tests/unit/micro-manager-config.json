{
  "participant_name": "Micro-Manager",
  "precice_config_file_path": "dummy-config.xml",
  "interfaces": [
    {
      "mesh_name": "Macro-Mesh",
      "read_data": [{ "name": "Macro-Scalar-Data" }, { "name": "Macro-Vector-Data" }],
      "write_data": [{ "name": "Micro-Scalar-Data" }, { "name": "Micro-Vector-Data" }]
    }
  ],
  "micro_manager": {
    "micro_file_names": ["test_micro_manager"],
    "simulation_params": {
      "micro_dt": 0.1,
      "micro_output_n": 10,
      "macro_domain_bounds": [0.0, 25.0, 0.0, 25.0, 0.0, 25.0],
      "adaptivity": true,
      "adaptivity_settings": {
        "type": "local",
        "data": ["Macro-Scalar-Data", "Macro-Vector-Data"],
        "history_param": 0.5,
        "coarsening_constant": 0.3,
        "refining_constant": 0.4,
        "every_implicit_iteration": false,
        "similarity_measure": "L1"
      }
    }
  }
}
