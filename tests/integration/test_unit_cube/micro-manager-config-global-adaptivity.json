{
  "participant_name": "Micro-Manager",
  "precice_config_file_path": "precice-config.xml",
  "interfaces": [
    {
      "mesh_name": "Macro-Cube-Mesh",
      "read_data": [{ "name": "Macro-1" }],
      "write_data": [{ "name": "Micro-1" }, { "name": "Micro-2" }]
    }
  ],
  "micro_manager": {
    "micro_file_names": ["micro_dummy"],
    "simulation_params": {
      "micro_dt": 1.0,
      "macro_domain_bounds": [0, 1, 0, 1, 0, 1],
      "adaptivity": true,
      "adaptivity_settings": {
        "type": "global",
        "data": ["Micro-1", "Micro-2"],
        "history_param": 0.5,
        "coarsening_constant": 0.3,
        "refining_constant": 0.4,
        "every_implicit_iteration": true
      }
    }
  }
}
